# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: AlphaVantage free key enables earnings call transcripts.
# Get one at: https://www.alphavantage.co/support/#api-key
# If unset, the analyzer works fine without transcripts.
ALPHAVANTAGE_API_KEY=

# Optional: override the SQLite cache location (defaults to ./cache.db)
# CACHE_DB_PATH=/tmp/cache.db

# Optional: Turso credentials for a persistent, free-tier cloud SQLite.
# When BOTH are set, cache.py uses libsql instead of local sqlite3.
# Create a free DB at https://turso.tech (9 GB / 1B reads / 25M writes free).
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_auth_token_here

# SEC EDGAR is free — no API key needed
